{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-memory-os.local/schema/correction-v1.json",
  "title": "PMO Correction v1",
  "type": "object",
  "required": ["schema", "id", "type", "created_at", "source", "priority", "status", "repeat_error_count"],
  "properties": {
    "schema": {"const": "pmo.correction/v1"},
    "type": {"const": "correction"},
    "priority": {"enum": ["low", "normal", "high", "critical"]},
    "status": {"enum": ["active", "superseded", "archived"]},
    "repeat_error_count": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true
}
