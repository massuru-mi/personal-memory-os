{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-memory-os.local/schema/daily-session-v1.json",
  "title": "PMO Daily Session v1",
  "type": "object",
  "required": ["schema", "source", "session_id", "topic", "date", "updated_at"],
  "properties": {
    "schema": {"const": "pmo.daily-session/v1"},
    "source": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
